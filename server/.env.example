NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_VERSION=0.1.0
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000
# Number of proxy hops in front of the API (Render/Railway/Fly = 1, direct = 0)
TRUST_PROXY_HOPS=0
BODY_LIMIT=1mb

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
# Comma-separated extra origins for preview deployments
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/easytube
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
# Retries *after* the first attempt, with linear backoff (base * attempt).
MONGO_CONNECT_RETRIES=3
MONGO_RETRY_BASE_DELAY_MS=1000
# Integration tests only. They drop the database they connect to, so they get
# their own throwaway name and refuse to run against MONGODB_URI.
# One variable per suite: vitest runs them in parallel, and a shared database
# would let one suite's dropDatabase() delete another's in-flight data.
MONGODB_TEST_BASE=mongodb://127.0.0.1:27017
MONGODB_DATASTORES_TEST_DB=easytube_datastores_test
MONGODB_MODELS_TEST_DB=easytube_models_test
MONGODB_AUTH_TEST_DB=easytube_auth_test

REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
# Must stay null for BullMQ to work; it manages its own retries.
REDIS_MAX_RETRIES_PER_REQUEST=
# Namespaces every key so a shared Redis instance stays safe.
REDIS_KEY_PREFIX=easytube:

# When false, boot continues (and /health/ready reports 503) if a datastore is
# unreachable. Must be true in production, where the schema rejects false.
REQUIRE_DATABASES_ON_BOOT=false

# ---------------------------------------------------------------------------
# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be >= 32 chars and must differ from each other.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=easytube_dev_access_secret_change_me_32ch
JWT_REFRESH_SECRET=easytube_dev_refresh_secret_change_me_32ch
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Must match the value in the tokens. Change it to invalidate every access token
# at once, without touching refresh sessions.
JWT_ISSUER=easytube-api
JWT_AUDIENCE=easytube-client

# Mixed into every password before hashing, so a stolen database alone is not
# enough to mount an offline cracking run. Required in production, >= 32 chars.
# Generate a different value per environment: changing it invalidates nothing on
# its own, but it must stay stable or existing hashes stop verifying.
AUTH_PEPPER=

# Consecutive failed sign-ins before the account is locked, and how long the
# lock lasts. A success resets the counter.
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_MINUTES=15

# Argon2id cost. The defaults are the OWASP baseline; raise them as hardware
# allows, and expect `timeCost` below 2 to be rejected.
# `argon2` is a native module: npm may report that its install script was
# skipped. It still works from its prebuilt binary, but a source build needs a
# toolchain (Python + a C++ compiler) on machines without a matching prebuild.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# The refresh cookie carries the durable credential, so `httpOnly` and `secure`
# are not options in practice. `none` is required when the API and the client are
# on different sites, and the schema rejects it unless COOKIE_SECURE is true.
# Leave COOKIE_SECURE empty for http://localhost development.
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.easytube.app

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_ANALYZE=30
RATE_LIMIT_DOWNLOAD=10
RATE_LIMIT_AUTH=10

# ---------------------------------------------------------------------------
# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, Spaces)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_MINUTES=60
# Scratch space for ffmpeg + in-flight downloads. Never commit.
TEMP_DIR=tmp

# ---------------------------------------------------------------------------
# Media tooling
# ---------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

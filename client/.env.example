# ---------------------------------------------------------------------------
# EasyTube client environment
# All variables must be prefixed with VITE_ to be exposed to the browser.
# Only VITE_* values are bundled into the client - never put a secret here.
# ---------------------------------------------------------------------------

# Relative in local dev (Vite proxies /api) and on Vercel/Netlify.
# Use an absolute origin (https://api.easytube.app/api/v1) for split hosting.
VITE_API_BASE_URL=/api/v1

VITE_API_TIMEOUT_MS=15000
VITE_HEALTH_POLL_INTERVAL_MS=30000
VITE_APP_NAME=EasyTube

# Only used by vite.config.ts for the dev proxy target.
VITE_DEV_API_PROXY=http://localhost:5000
